# =====================================================================
# Plantilla de Variables de Entorno - MercaUca (ProyectoSeguridad)
# Copia este archivo como .env dentro de backend/ antes de iniciar.
# NUNCA subas tu archivo .env real con credenciales al repositorio.
# =====================================================================

# ----- Servidor API / Frontend -----
PORT=5048
NODE_ENV=development

# ----- Base de Datos MySQL 8 -----
# Si usas MySQL nativo usa DB_PORT=3306; si usas docker-compose.yml usa DB_PORT=3308
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mercauca
DB_USER=root
DB_PASSWORD=CAMBIAR_POR_LA_CLAVE_LOCAL

# ----- Autenticación y Registro (JWT / Cookies HttpOnly) -----
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_JWT_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=60m
REGISTRO_TOKEN_SECRET=CAMBIAR_POR_UN_SECRETO_REGISTRO_ALEATORIO
COOKIE_SECURE=false

# ----- Correo SMTP (Requerido para códigos OTP de registro y facturas) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MercaUca" <no-reply@mercauca.local>
